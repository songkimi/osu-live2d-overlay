<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>osu-live2d-overlay</AssemblyName>
    <RootNamespace>OsuLive2dOverlay</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- WebView2：在 WPF 里承载 Live2D 渲染页面 -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

  <ItemGroup>
    <!-- 页面与配置跟着程序一起复制到输出目录。
         用 None Update（而不是 Content Include）是为了避免和 SDK 默认通配重复包含同一文件。 -->
    <None Update="web\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
