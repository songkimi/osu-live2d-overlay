<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>osu-live2d-overlay</AssemblyName>
    <RootNamespace>OsuLive2dOverlay</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- WebView2：在 WPF 里承载 Live2D 渲染页面 -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

  <ItemGroup>
    <!-- 页面跟着程序一起复制到输出目录。
         用 None Update（而不是 Content Include）是为了避免和 SDK 默认通配重复包含同一文件。 -->
    <None Update="web\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- config.json 只在输出目录**还没有**的时候复制一份当模板。
       不能像 web\ 那样用 PreserveNewest：输出目录那份是**运行期状态**
       （界面感知、拖出来的窗口位置、各界面角度都写在里面，根模板里根本没有这些），
       而根模板是给人看的文档式模板。用 PreserveNewest 的话，只要改一下根模板，
       下一次构建就会把运行配置整个覆盖掉 —— 配置直接丢。
       想拿一份新模板：删掉输出目录的 config.json 再构建。 -->
  <Target Name="CopyConfigTemplate" AfterTargets="Build" Condition="!Exists('$(OutDir)config.json')">
    <Copy SourceFiles="config.json" DestinationFolder="$(OutDir)" />
  </Target>

</Project>
