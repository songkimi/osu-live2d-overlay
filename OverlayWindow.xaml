<!-- ============================================================
     OverlayWindow.xaml —— Live2D 悬浮窗（WebView2 承载渲染）
     注意两个 WebView2 特有的坑：
       ① Airspace：WebView2 是原生窗口，WPF 元素盖不到它上面
          → 所以"调整模式"的虚线框不能在它上面叠加，只能先把 WebView2 藏起来
       ② 点击穿透必须传到 WebView2 的子窗口（代码后置里用 EnumChildWindows 处理）
     ============================================================ -->
<Window x:Class="OsuLive2dOverlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="osu-live2d-overlay"
        Width="430" Height="620"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        ResizeMode="CanResize">

    <Grid>
        <!-- Live2D 渲染区（WebView2）；透明背景在代码里设置（DefaultBackgroundColor=Transparent） -->
        <wv2:WebView2 x:Name="Web" />

        <!-- 调整模式占位层：因为盖不到 WebView2 上面，调整时会先把 WebView2 隐藏 -->
        <Grid x:Name="AdjustLayer" Visibility="Collapsed" Background="#E6101418">
            <Rectangle RadiusX="14" RadiusY="14" Stroke="#FFFFC107" StrokeThickness="3" StrokeDashArray="6 4" />
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="调整模式" FontSize="20" FontWeight="Bold"
                           Foreground="#FFFFC107" HorizontalAlignment="Center" />
                <TextBlock x:Name="AdjustHint" Foreground="White" FontSize="13"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360"
                           HorizontalAlignment="Center" Margin="0,10,0,0" />
                <TextBlock Text="Ctrl+Alt+T 完成 · Ctrl+Alt+R 重载页面 · Ctrl+Alt+1/2/3 测试表情 · Ctrl+Alt+V 试听语音 · Ctrl+Alt+Q 退出"
                           Foreground="#FFFFC107" FontSize="12" TextWrapping="Wrap" MaxWidth="380"
                           HorizontalAlignment="Center" Margin="0,14,0,0" />
            </StackPanel>
        </Grid>

        <!-- 右上角状态条（同样会被 WebView2 遮住，所以只在调整模式/出错时显示） -->
        <Border x:Name="StatusBar" Visibility="Collapsed"
                VerticalAlignment="Top" HorizontalAlignment="Center"
                Background="#CC7A2B2B" CornerRadius="0,0,8,8" Padding="10,4">
            <TextBlock x:Name="StatusText" Foreground="White" FontSize="12" />
        </Border>
    </Grid>
</Window>
