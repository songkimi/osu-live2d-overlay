<!--
  Tokens.Dark.xaml —— 深色主题的 Design Token
  ============================================================
  【为什么深浅必须同时定】
  参考图全是浅色，但本软件的用户是打歌玩家 —— 夜里用深色的概率很高。
  深色不是"把颜色反过来"：**靠阴影分层在深色下会失效**，
  所以这里改用"表面比背景亮一档 + 描边"来分层（Effect.CardShadow 也调得很轻）。

  【★ key 必须与 Tokens.Light.xaml 完全一致】——
  少一个，切主题时那一项就变回 HC 的默认值，而且**不报错**
  （DynamicResource 找不到 key 时静默地不赋值）。改这个文件请两边对着改。
  `Resources/Styles/Tokens.Light.xaml` 里有完整的体系说明，这里不重复。

  【深色下主色要提亮】#2D9CDB 直接放在深底上对比度不够，这里用 #4AAEE8。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ============================================================
         一、颜色 —— 与浅色同一批 HandyControl 皮肤变量名
         ============================================================ -->
    <Color x:Key="PrimaryColor">#FF4AAEE8</Color>
    <Color x:Key="DarkPrimaryColor">#FF63BCEF</Color>
    <Color x:Key="LightPrimaryColor">#FF1B3A52</Color>
    <Color x:Key="AccentColor">#FF4AAEE8</Color>
    <Color x:Key="DarkAccentColor">#FF3399D6</Color>

    <Color x:Key="BackgroundColor">#FF1E2228</Color>
    <Color x:Key="RegionColor">#FF262B33</Color>
    <Color x:Key="SecondaryRegionColor">#FF22272E</Color>
    <Color x:Key="ThirdlyRegionColor">#FF2C323A</Color>

    <Color x:Key="BorderColor">#FF363C45</Color>
    <Color x:Key="SecondaryBorderColor">#FF2F353D</Color>

    <Color x:Key="PrimaryTextColor">#FFE8EAED</Color>
    <Color x:Key="SecondaryTextColor">#FF9AA4B0</Color>
    <Color x:Key="ThirdlyTextColor">#FF9AA4B0</Color>
    <Color x:Key="TitleColor">#FFE8EAED</Color>
    <Color x:Key="ReverseTextColor">#FF10222E</Color>
    <Color x:Key="TextIconColor">#FF9AA4B0</Color>

    <Color x:Key="SuccessColor">#FF4FBF6A</Color>
    <Color x:Key="WarningColor">#FFF0B155</Color>
    <Color x:Key="DangerColor">#FFEE6A6A</Color>
    <Color x:Key="InfoColor">#FF4AAEE8</Color>

    <Color x:Key="Color.TextDisabled">#FF5F6873</Color>
    <Color x:Key="Color.Shadow">#40000000</Color>

    <!-- ============================================================
         二、语义 Brush（与浅色同名同结构）
         ============================================================ -->
    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="Brush.PrimaryHover" Color="{StaticResource DarkPrimaryColor}" />
    <SolidColorBrush x:Key="Brush.PrimaryPressed" Color="{StaticResource DarkAccentColor}" />
    <SolidColorBrush x:Key="Brush.PrimarySoft" Color="{StaticResource LightPrimaryColor}" />

    <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource RegionColor}" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="{StaticResource SecondaryRegionColor}" />
    <SolidColorBrush x:Key="Brush.NavSelected" Color="{StaticResource LightPrimaryColor}" />

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="{StaticResource Color.TextDisabled}" />
    <SolidColorBrush x:Key="Brush.TextOnPrimary" Color="{StaticResource ReverseTextColor}" />

    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="Brush.Divider" Color="{StaticResource SecondaryBorderColor}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource DangerColor}" />

    <!-- 深色下阴影几乎看不见 —— 分层靠"表面比背景亮一档"，这里只留一点浮起感 -->
    <DropShadowEffect x:Key="Effect.CardShadow"
                      BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.35" Color="#FF000000" />

    <!-- ============================================================
         三、圆角 / 间距 / 尺寸（主题只换颜色，这些与浅色一致）
         ============================================================ -->
    <CornerRadius x:Key="Radius.Card">12</CornerRadius>
    <CornerRadius x:Key="Radius.Control">6</CornerRadius>
    <CornerRadius x:Key="Radius.Chip">4</CornerRadius>

    <Thickness x:Key="Pad.Card">16</Thickness>
    <Thickness x:Key="Pad.Page">20</Thickness>
    <Thickness x:Key="Pad.Control">8,6,8,6</Thickness>

    <sys:Double x:Key="Size.NavWidth">180</sys:Double>
    <sys:Double x:Key="Size.IdentifierListWidth">220</sys:Double>
    <sys:Double x:Key="Size.PreviewWidth">360</sys:Double>
    <sys:Double x:Key="Size.SpaceSmall">8</sys:Double>
    <sys:Double x:Key="Size.SpaceMedium">12</sys:Double>
    <sys:Double x:Key="Size.SpaceLarge">20</sys:Double>

    <!-- ============================================================
         四、字号层级（主题不换字号，与浅色完全一致）
         ★ 必须是整数 —— 理由见 Tokens.Light.xaml 同段落的说明
         （非整数字号在小字号下会让字形"长得像错别字"）
         ============================================================ -->
    <sys:Double x:Key="FontSize.PageTitle">19</sys:Double>
    <sys:Double x:Key="FontSize.CardTitle">16</sys:Double>
    <sys:Double x:Key="FontSize.Body">14</sys:Double>
    <sys:Double x:Key="FontSize.Caption">13</sys:Double>
    <sys:Double x:Key="FontSize.Label">12</sys:Double>

</ResourceDictionary>
