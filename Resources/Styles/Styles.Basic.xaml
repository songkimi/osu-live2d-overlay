<!--
  Styles.Basic.xaml —— 我们自己的基础样式（卡片 / 导航项 / 文字层级）
  ============================================================
  与 HCOverrides 的分工：
    · HCOverrides = **改 HC 原有控件的颜色**（不动结构）
    · 本文件       = **我们自己的样式**（HC 没有的、或 HC 那个不合用的）

  【为什么字体在这里而不是 Tokens】
  "跟随系统"在 WPF 里就是 `SystemFonts.MessageFontFamily` —— 这是个**运行时取值**，
  不是常量，所以它更像"基础设定"而不是"设计常量"。用户改字体时由代码替换这个 key。

  【所有 FontSize 一律 DynamicResource】
  字号是用户可调的（通用.字号），必须能在运行时换掉 —— 见 Infrastructure/FontScale.cs。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         字体
         ============================================================
         【2026-09-20：小字"像错别字"的真正原因是前两步，不是字体】

         排查过程（记录在这里，免得以后又怀疑到字体上）：
           ① 字号曾经不是整数（12.6 / 11.9 DIP）→ 已吸附到整数（FontScale.Snap）
           ② 排版模式用了 Ideal → 已改 Display
           ③ 曾怀疑"字体本身"（Microsoft YaHei UI 是被压缩过字距的变体）→ **实测推翻**
             用户在风格验证页第 ⑦ 节看过 5 个候选后反馈：
             **「1 就可以了，你列出来的 5 个字体都没问题」**
             —— 连原来那个 ① `Microsoft YaHei UI` 都正常了，说明**字体从来不是原因**，
             真正修好它的是 ①②。

         【但是有一条仍然成立】探针确认 `Segoe UI` / `Tahoma` / `Arial`
           **都没有中文字形**（查「处 置 灰」字形全为 False）。
           所以界面字体**不能是单一的英文字体** —— 那样中文要靠 fallback 渲染。

         【所以这里用"回退列表"】WPF 的 FontFamily 支持逗号分隔的候选，
         会**按字符**依次回退：先用第一个，第一个里没有这个字符就用下一个。
           · 中文系统：第一个 `Microsoft YaHei UI` 命中（就是用户选定的 ①）
           · 非中文系统/没装雅黑：`Segoe UI` 渲染拉丁字母、`DengXian` 兜中文
         两边都稳，且不需要任何代码。

         将来「应用 → 通用 → 字体」做好之后：
           · 用户选「跟随系统」→ 由代码拼成 `{SystemFonts.MessageFontFamily}, Microsoft YaHei UI, DengXian`
           · 用户指定具体字体 → 直接用那一个
         ============================================================ -->
    <FontFamily x:Key="FontFamily.UI">Microsoft YaHei UI, Microsoft YaHei, DengXian, Segoe UI</FontFamily>

    <!-- ============================================================
         文字层级 —— 界面上一处文字必须属于其中一层，不许随手写 FontSize
         （层级与倍率的定义在 Infrastructure/FontScale.cs，两边要一起改）
         ============================================================ -->

    <Style x:Key="Text.PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.PageTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.CardTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>

    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>

    <!-- 说明文字：卡片标题下面那行灰字、设置行的说明，都用它 -->
    <Style x:Key="Text.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 小标签：「重启后生效」这类标记 -->
    <Style x:Key="Text.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Label}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============================================================
         卡片：一组设置 = 一张卡（定稿 §8.2）
         用法：<Border Style="{DynamicResource Card}"> ... </Border>
         ============================================================ -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}" />
        <Setter Property="Padding" Value="{DynamicResource Pad.Card}" />
        <Setter Property="Effect" Value="{DynamicResource Effect.CardShadow}" />
    </Style>

    <!-- 卡片内部的"设置行"：标题 + 控件 + 说明 -->
    <Style x:Key="SettingRow" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <!-- ============================================================
         左侧导航项（ListBox 的 ItemContainerStyle）
         ============================================================ -->
    <!-- ============================================================
         左侧导航项
         ============================================================
         与页内 Tab 用**同一套手法**（两层叠着 + 透明度渐变）：
         原来是鼠标移上去硬切颜色，看着"生硬"。
         ============================================================ -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Margin="8,2">
                        <Border x:Name="HoverLayer" CornerRadius="8"
                                Background="{DynamicResource Brush.Divider}" Opacity="0" />
                        <Border x:Name="SelectedLayer" CornerRadius="8"
                                Background="{DynamicResource Brush.NavSelected}" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.24" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelectedLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelectedLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.24" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         页内 Tab（二级导航）
         ============================================================
         默认的 TabControl 是"工业风"：方角、灰底、鼠标移上去**硬切**颜色。
         这里换成与参考图一致的**圆角胶囊**，悬停 / 选中都用**透明度渐变**。

         ★ 为什么是"两层叠着 + 动画 Opacity"，而不是"动画背景色本身"：
           Storyboard 里的动画目标值**不能用 DynamicResource**（Storyboard 会被冻结），
           那样就只能写死颜色 —— 而写死的颜色不跟深浅主题走。
           所以这里让背景色照旧走 DynamicResource，**只动画它的透明度**：
           主题切换与柔和过渡两个要求就同时成立了。
         ============================================================ -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 标签条自己带边距；内容区不带（各页自己管自己的边距） -->
                        <TabPanel Grid.Row="0" IsItemsHost="True" Margin="20,18,20,0" />
                        <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid Margin="0,0,8,0">
                        <!-- 两层底色叠着：平时都透明；悬停露下面那层，选中露上面那层 -->
                        <Border x:Name="HoverLayer" CornerRadius="8"
                                Background="{DynamicResource Brush.Divider}" Opacity="0" />
                        <Border x:Name="SelectedLayer" CornerRadius="8"
                                Background="{DynamicResource Brush.PrimarySoft}" Opacity="0" />

                        <ContentPresenter ContentSource="Header"
                                          Margin="16,8"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.24" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelectedLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelectedLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.24" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- 禁用 = 还没做的那几个页：颜色压暗，鼠标也别变手 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         ★ 按钮：高度必须**跟着内容长**（2026-09-23）
         ============================================================
         【为什么要有这一条】
           HandyControl 的 Button 默认高度是 **28**（实测，见 `.build-verify/LayoutProbe`）。
           而按钮里一行中文正文要 **17.78**，两边还各有边框（2）——
           于是 `Padding` 的上下加起来**只要超过 8**，留给文字的内高就不够，**字的下半截被裁掉**。
           用户为这件事报过两次：
             · 「行为」页中间的小卡片 → 我把那三个按钮单独改成 `Height="Auto" MinHeight="40"`
             · 「配置档案」页底部那排按钮（`Padding="14,6"`）→ 内高只剩 14，裁掉一小块
           单点修两次之后才想明白：**该修的是按钮本身**，不是每一个按钮。
           所以在这里加一条隐式样式，全项目的按钮一起受益，也不用再逐个页面盯着。

         【为什么写得这么"松"】
           `Height="Auto"` 放开高度（本地 Height 会盖掉样式里的固定高度），
           `MinHeight="28"` 只做地板：小按钮（Padding 小）看起来和以前一样，
           大 Padding 的按钮自己长高，**永远装得下**。

         【★ 为什么必须 `BasedOn="{StaticResource ButtonDefault}"`】（2026-09-23 补，踩过一次）
           **隐式样式是"整体替换"，不是"叠加"** ——
           我第一版只写了 `<Style TargetType="Button">` 加三个 Setter，
           结果把 HandyControl 那份 Button 样式整个顶掉了：
           圆角、悬停变色、按下反馈**全部消失**，按钮变成了 WPF 的原始样子（用户一眼就看出来了）。
           加上 `BasedOn` 之后，"HC 的模板 + 我们只改高度"才成立。
           > 通用教训：**要给一个已存在的隐式样式加东西，必须 BasedOn 它**；
           > 不写 BasedOn 的隐式样式 = 把它换掉，而不是补充。
           > （HC 里这套键叫 `ButtonDefault` / `ButtonPrimary` / `ButtonDanger`…，
           >   隐式那份就是 BasedOn `ButtonDefault` 的。）
         ============================================================ -->
    <Style TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ============================================================
         设置行的"生效方式"标记（定稿 §1.1：三档都要看得见）
         ============================================================ -->
    <Style x:Key="Chip.Reload" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.PrimarySoft}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Chip}" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Text.Chip.Reload" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Label}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
        <Setter Property="Text" Value="需重载" />
    </Style>

    <!-- ============================================================
         字体图标（Segoe MDL2 Assets）
         ============================================================
         【为什么不用 HandyControl 的 PackIcon】
         实测（2026-09-20）：**HandyControl 3.5.1 里没有 PackIcon，也没有 PackIconKind** ——
         把 DLL 的 372 个导出类型全列出来核对过，它的 HandyControl.Controls 有 178 个控件，
         就是没有它。所以原方案"图标优先用 hc:PackIcon"不成立，改用系统自带的图标字体。

         【为什么是 Segoe MDL2 Assets】
         · Win10 / Win11 **自带** —— 零外部文件、零授权问题
         · 矢量、可换色、随字号缩放
         · 不必把 SVG 转成 XAML Path（那件事又费工又容易画错）

         用法：<TextBlock Style="{DynamicResource Icon}" Text="&#xE74D;" />   （垃圾桶）

         ⚠ **字形码是记出来的，必须在真机上核对**：
           风格验证页里摆了一整排候选，错的会显示成方块或别的图。
           核对通过之后再往真界面里用 —— 别凭这个文件里的注释就当它对。
         ============================================================ -->
    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <!-- 图标字体不跟随正文字体，所以这里**不引** FontFamily.UI -->
    </Style>

    <Style x:Key="Icon.Small" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="Icon.Nav" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Width" Value="24" />
    </Style>

    <!-- ============================================================
         开关（ToggleSwitch）
         ============================================================
         【为什么自己写】实测 HandyControl 3.5.1 **没有 ToggleSwitch**
         （它只有 ToggleBlock —— 那是显示"开/关"字样的小方块，不是滑动开关）。

         做法：一条圆角轨道 + 一个圆形滑块；选中时轨道变主色、滑块右移。
         它就是个 ToggleButton 换模板，所以能直接用 IsChecked 绑定、也能被 IsEnabled 置灰。
         ============================================================ -->
    <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Track" CornerRadius="12"
                                Background="{DynamicResource Brush.Border}" />
                        <Border x:Name="Thumb"
                                Width="18" Height="18" CornerRadius="9"
                                Background="White"
                                HorizontalAlignment="Left"
                                Margin="3,0,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.25" />
                            </Border.Effect>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background"
                                    Value="{DynamicResource Brush.Primary}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <!-- 置灰时也要一眼看出"不能动"，而不是"点了没反应"（定稿 §1.2） -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.35" />
                            <Setter TargetName="Thumb" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
