<!--
  HCOverrides.xaml —— 把 HandyControl 的笔刷接到我们的 Token 上
  ============================================================
  【★ 2026-09-20 实测后才搞清的分工，别搞反】
  把 HC 的字典打开看过，它的颜色分**两层**：

    · 皮肤字典 SkinDefault / SkinDark（35 个 key）→ **只有 `…Color`**
    · Themes/Theme.xaml（952 个 key）→ 里面有 **37 个 `…Brush`**，从那些 Color 派生

  所以：
    ① **"换肤"的正主是 `…Color`** —— 我们在 `Tokens.Light/Dark.xaml` 里
       就是用 HC 的 Color 名定义的（PrimaryColor / RegionColor …）。
    ② **本文件负责 `…Brush`**：万一 HC 某个控件通过 `{StaticResource PrimaryBrush}`
       把笔刷在解析时就定死了（那样只换 Color 是追不上的），
       这里用同名 Brush 覆盖一遍，**双保险**。
    ③ 本文件里的笔刷**引我们的 Color key**（`{DynamicResource PrimaryColor}`），
       所以色值仍然只有 Token 里那一处 —— 这里不出现任何写死的颜色。

  【为什么用 DynamicResource 而不是 StaticResource】
  StaticResource 在本字典解析时就把颜色**定死**了；换深色主题只替换 Token 字典时，
  这些笔刷不会跟着变（界面会花）。DynamicResource 才会跟着变。
  代价是笔刷不能被冻结（一点点性能损失，对设置界面可以忽略）。

  【哪些 HC 笔刷故意不覆盖】
  `DefaultBrush` / `DarkDefaultBrush`（HC 的中性色，留给它自己的"默认按钮"）、
  `ColorPickerRainbowBrush`、`SortBy*DrawingBrush`（颜色选择器与排序图标专用）、
  `Light*Brush` 那一组（浅色底 + 深色字的组合，我们的界面用的是自己的 `Brush.Window` 打底）
  —— 这些与我们的主题无关，覆盖了反而可能弄坏 HC 自己的控件。

  【它必须排在 Tokens 之后加载】—— 否则引用的 Color key 还不在（见 App.xaml 的顺序）。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========== 主色 ========== -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource PrimaryColor}" />
    <SolidColorBrush x:Key="DarkPrimaryBrush" Color="{DynamicResource DarkPrimaryColor}" />
    <SolidColorBrush x:Key="LightPrimaryBrush" Color="{DynamicResource LightPrimaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="DarkAccentBrush" Color="{DynamicResource DarkAccentColor}" />

    <!-- ========== 背景 / 区域 ========== -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{DynamicResource BackgroundColor}" />
    <SolidColorBrush x:Key="RegionBrush" Color="{DynamicResource RegionColor}" />
    <SolidColorBrush x:Key="SecondaryRegionBrush" Color="{DynamicResource SecondaryRegionColor}" />
    <SolidColorBrush x:Key="ThirdlyRegionBrush" Color="{DynamicResource ThirdlyRegionColor}" />

    <!-- ========== 边框 ========== -->
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
    <SolidColorBrush x:Key="SecondaryBorderBrush" Color="{DynamicResource SecondaryBorderColor}" />

    <!-- ========== 文字 ========== -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{DynamicResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{DynamicResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="ThirdlyTextBrush" Color="{DynamicResource ThirdlyTextColor}" />
    <SolidColorBrush x:Key="TitleBrush" Color="{DynamicResource TitleColor}" />
    <SolidColorBrush x:Key="ReverseTextBrush" Color="{DynamicResource ReverseTextColor}" />
    <SolidColorBrush x:Key="TextIconBrush" Color="{DynamicResource TextIconColor}" />

    <!-- ========== 状态（含 HC 的 Dark 变体：我们不做"更深的状态色"，统一用同一个）========== -->
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}" />
    <SolidColorBrush x:Key="DarkSuccessBrush" Color="{DynamicResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}" />
    <SolidColorBrush x:Key="DarkWarningBrush" Color="{DynamicResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}" />
    <SolidColorBrush x:Key="DarkDangerBrush" Color="{DynamicResource DangerColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{DynamicResource InfoColor}" />
    <SolidColorBrush x:Key="DarkInfoBrush" Color="{DynamicResource InfoColor}" />

    <!-- ========== 圆角：用我们的值替换 HC 的默认值 ========== -->
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>

</ResourceDictionary>
