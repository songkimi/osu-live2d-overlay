<!-- ============================================================
     RunTimeView.xaml —— 「数据与档案 → 运行期调整」页

     【这一页存在的理由】
       悬浮窗被拖到别处时，改动先攒在内存里、不立刻写档案（定稿 §3.6.2）。
       于是需要一个地方让用户**看得见、存得下**。
       没有它，唯一的保存机会就是关掉悬浮窗时弹的那个询问框 ——
       手一快点了「否」，这次调整就永远没了。

     【两块内容】
       · 待保存的调整 —— 可操作（保存 / 放弃）
       · 档案里的位置 —— **只读参考**，用来判断"要不要把刚才拖的存下来"。
         它不带编辑按钮是刻意的：那个字段的真正编辑入口在「界面感知」页，
         一个字段只有一个编辑入口。
     ============================================================ -->
<UserControl x:Class="OsuLive2dOverlay.RunTimeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource FontFamily.UI}"
             FontSize="{DynamicResource FontSize.Body}"
             Foreground="{DynamicResource Brush.TextPrimary}"
             IsVisibleChanged="OnIsVisibleChanged">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel Margin="20">

                <TextBlock Text="运行期调整" Style="{DynamicResource Text.PageTitle}" />
                <TextBlock Text="拖动悬浮窗之后，改动会先攒在这里，等你决定存不存。"
                           TextWrapping="Wrap"
                           Style="{DynamicResource Text.Caption}" Margin="0,6,0,16" />

                <!-- ① 待保存的调整 -->
                <Border Style="{DynamicResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="待保存的调整" Style="{DynamicResource Text.CardTitle}" />
                        <TextBlock Text="{Binding PendingSummary}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Style="{DynamicResource Text.Caption}"
                                   Margin="0,6,0,0" />

                        <TextBlock Text="没有待保存的调整。"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Margin="0,12,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPending}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding PendingRows}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding SceneName}"
                                                   VerticalAlignment="Center"
                                                   Style="{DynamicResource Text.Body}" />
                                        <TextBlock Grid.Column="1" Text="{Binding PositionText}"
                                                   VerticalAlignment="Center"
                                                   Style="{DynamicResource Text.Body}" />
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}"
                                                   VerticalAlignment="Center"
                                                   Style="{DynamicResource Text.Body}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ② 档案里记着的（只读参考） -->
                <Border Style="{DynamicResource Card}">
                    <StackPanel>
                        <TextBlock Text="档案里记着的窗口位置" Style="{DynamicResource Text.CardTitle}" />

                        <ItemsControl ItemsSource="{Binding SavedRows}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding SceneName}"
                                                   VerticalAlignment="Center"
                                                   Style="{DynamicResource Text.Body}" />
                                        <TextBlock Grid.Column="1" Text="{Binding PlacementText}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                   Style="{DynamicResource Text.Body}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 底部动作栏 -->
        <Border Grid.Row="1"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="放弃这些调整" Padding="14,6" Command="{Binding DiscardPendingCommand}" />
                <Button Content="保存到当前档案" Padding="18,6" Margin="8,0,0,0"
                        Command="{Binding SavePendingCommand}"
                        Background="{DynamicResource Brush.Primary}"
                        Foreground="{DynamicResource Brush.TextOnPrimary}"
                        BorderBrush="{DynamicResource Brush.Primary}" />
            </StackPanel>
        </Border>

        <!-- Toast -->
        <Border x:Name="ToastPanel"
                Grid.Row="0" Grid.RowSpan="2"
                Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,24,68"
                Background="{DynamicResource Brush.TextPrimary}"
                CornerRadius="6" Padding="16,10"
                MouseLeftButtonUp="OnToastClick">
            <TextBlock x:Name="ToastText"
                       Foreground="{DynamicResource Brush.Surface}"
                       Style="{DynamicResource Text.Body}" />
        </Border>
    </Grid>
</UserControl>
