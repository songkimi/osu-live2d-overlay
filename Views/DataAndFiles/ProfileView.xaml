<!-- ============================================================
     ProfileView.xaml —— 「数据与档案 → 配置档案」页

     【一套档案 = 一份完整的配置】
       模型、规则、语音、界面感知、每个界面的窗口位置，全都在里面。
       切换档案 = 整个软件换一套 —— 这正是"档案"和"软件设置"分开的意义：
       换角色玩的时候，费劲调好的外观 / 字体 / 热键**不该跟着变**。

     【按钮长在行上】
       一行 = 一个档案 + 它的几个动作（切换 / 改名 / 删除），
       和「文件位置」页同一个样子。不做"先选中再操作"，
       那一份选中状态会因为列表刷新而失效，修起来全是不值当的麻烦。

     【当前那份不给「删除」】
       删掉正在用的档案，用户会在一次误点里同时丢掉"档案"和"当前选择"两样东西。
       规则简单可预测：先切走，再回来删。
       （ProfileStore 也会拒绝，界面这一层只是先不让按。）
     ============================================================ -->
<UserControl x:Class="OsuLive2dOverlay.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource FontFamily.UI}"
             FontSize="{DynamicResource FontSize.Body}"
             Foreground="{DynamicResource Brush.TextPrimary}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel Margin="20">

                <TextBlock Text="配置档案" Style="{DynamicResource Text.PageTitle}" />
                

                <Border Style="{DynamicResource Card}">
                    <StackPanel>
                        <!-- 现在用的是哪一份 —— 放最上面，因为它是这一页的"当前状态" -->
                        <TextBlock Style="{DynamicResource Text.Body}">
                            <Run Text="正在使用：" Foreground="{DynamicResource Brush.TextSecondary}" />
                            <Run Text="{Binding CurrentName}" FontWeight="SemiBold" />
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding Profiles}" Margin="0,14,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   ToolTip="{Binding Path}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Style="{DynamicResource Text.Body}" />

                                        <Border Grid.Column="1"
                                                VerticalAlignment="Center" Margin="8,0,0,0"
                                                Padding="6,1"
                                                Background="{DynamicResource Brush.Primary}"
                                                CornerRadius="{DynamicResource Radius.Chip}"
                                                Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="当前"
                                                       Foreground="{DynamicResource Brush.TextOnPrimary}"
                                                       Style="{DynamicResource Text.Caption}" />
                                        </Border>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ModifiedText}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                   Style="{DynamicResource Text.Caption}" />

                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="12,0,0,0">
                                            <Button Content="切换" Padding="10,5"
                                                    Visibility="{Binding CanSwitch, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.SwitchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="改名" Padding="10,5" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.BeginRenameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="删除" Padding="10,5" Margin="6,0,0,0"
                                                    Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 一个档案都没有是不可能发生的（当前那份总在），
                             但万一目录读不出来，说一句比留一片空白强 -->
                        <TextBlock Text="没有找到任何档案。"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Profiles.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 底部动作栏：左边是"对档案做的事"，右边是"文件在哪" -->
        <Border Grid.Row="1"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="新建档案" Padding="14,6" Command="{Binding BeginNewCommand}" />
                    <Button Content="导入…" Padding="14,6" Margin="8,0,0,0" Click="OnImportClick" />
                    <Button Content="导出当前档案…" Padding="14,6" Margin="8,0,0,0" Click="OnExportClick" />
                </StackPanel>

                <Button Grid.Column="1" Content="打开档案文件夹" Padding="14,6"
                        Command="{Binding OpenFolderCommand}" />
            </Grid>
        </Border>

        <!-- 编辑层：新建 / 改名共用（WPF 没有内置的输入框对话框） -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                Background="#66000000"
                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
            <Border Style="{DynamicResource Card}"
                    Width="380"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="{Binding EditTitle}" Style="{DynamicResource Text.CardTitle}" />

                    <TextBox x:Name="EditBox"
                             Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,12,0,0"
                             Padding="8,6"
                             VerticalContentAlignment="Center"
                             KeyDown="OnEditKeyDown" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="取消" Padding="14,6" Command="{Binding CancelEditCommand}" />
                        <Button Content="确定" Padding="18,6" Margin="8,0,0,0"
                                Command="{Binding ConfirmEditCommand}"
                                Background="{DynamicResource Brush.Primary}"
                                Foreground="{DynamicResource Brush.TextOnPrimary}"
                                BorderBrush="{DynamicResource Brush.Primary}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Toast -->
        <Border x:Name="ToastPanel"
                Grid.Row="0" Grid.RowSpan="2"
                Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,24,68"
                Background="{DynamicResource Brush.TextPrimary}"
                CornerRadius="6" Padding="16,10"
                MouseLeftButtonUp="OnToastClick">
            <TextBlock x:Name="ToastText"
                       Foreground="{DynamicResource Brush.Surface}"
                       Style="{DynamicResource Text.Body}" />
        </Border>
    </Grid>
</UserControl>
