<!-- ============================================================
     LogView.xaml —— 「数据与档案 → 日志与诊断」页
     ============================================================
     【它显示的是内存里那份日志】
       日志有两条去向（见 DebugLog.cs）：内存环形缓冲（总是记）+ 日志文件（只在调试模式）。
       所以**不开调试模式也能看到日志**；"导出"和"打包诊断"才去碰文件。

     【列表用 ListBox + 虚拟化】
       日志可能有几千条，全实体化会卡。ListBox 默认就开虚拟化，这里只是显式写明。
       ★ 而这里**不做**"行模板"之类的美化 —— 日志是查问题用的，可读性 > 好看。

     【等宽字体】
       日志一行里有时间戳 + 内容，等宽看起来整齐得多。
       但 Consolas 没有中文字形 —— 所以写成**回退列表** `Consolas, Microsoft YaHei UI`：
       英文数字走 Consolas，汉字自动落到雅黑（WPF 的 FontFamily 是按字符回退的）。

     【自动滚动】
       新日志进来时自动滚到底；但用户一旦手动往上翻，就**停掉自动滚动**（否则他会一直被拽到底部）。
       翻回底部再自动恢复。检测逻辑在 code-behind 的 ScrollChanged 里。
     ============================================================ -->
<UserControl x:Class="OsuLive2dOverlay.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:OsuLive2dOverlay"
             FontFamily="{DynamicResource FontFamily.UI}"
             FontSize="{DynamicResource FontSize.Body}"
             Foreground="{DynamicResource Brush.TextPrimary}"
             Loaded="OnLoaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 标题 -->
            <RowDefinition Height="Auto" />   <!-- 说明 -->
            <RowDefinition Height="Auto" />   <!-- 工具条 -->
            <RowDefinition Height="*" />      <!-- 日志列表 -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="日志与诊断"
                   Style="{DynamicResource Text.PageTitle}"
                   Margin="20,20,20,0" />

        

        <!-- 工具条：状态 + 设置 + 动作 -->
        <Border Grid.Row="2" Style="{DynamicResource Card}" Padding="16,12" Margin="20,16,20,0">
            <StackPanel>
                <TextBlock Text="{Binding FileStateText}"
                           Style="{DynamicResource Text.Caption}"
                           TextWrapping="Wrap" />

                <WrapPanel Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
                        <TextBlock Text="调试模式" VerticalAlignment="Center"
                                   Style="{DynamicResource Text.Caption}" Margin="0,0,8,0" />
                        <ToggleButton svc:SettingIndex.Path="调试模式"
                                      Style="{DynamicResource ToggleSwitch}"
                                      IsChecked="{Binding DebugMode}"
                                      ToolTip="打开才开始写日志文件（内存里那份不受影响）。顺带会在画面上显示开发期信息。" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
                        <TextBlock Text="保留月数" VerticalAlignment="Center"
                                   Style="{DynamicResource Text.Caption}" Margin="0,0,8,0" />
                        <ComboBox svc:SettingIndex.Path="日志.保留月数"
                                  Width="90"
                                  ItemsSource="{Binding RetainMonthOptions}"
                                  SelectedItem="{Binding RetainMonths}"
                                  ToolTip="启动时清掉多少个月之前的月份文件夹。本月永远保留。" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
                        <TextBlock Text="详细输出" VerticalAlignment="Center"
                                   Style="{DynamicResource Text.Caption}" Margin="0,0,8,0" />
                        <ToggleButton svc:SettingIndex.Path="日志.详细输出"
                                      Style="{DynamicResource ToggleSwitch}"
                                      IsChecked="{Binding Verbose}"
                                      ToolTip="把开发期信息（收到连击、触发了哪个表情）也写进日志。" />
                    </StackPanel>

                    <Button Content="打开日志文件夹" Padding="12,6" Margin="0,0,8,8"
                            Command="{Binding OpenLogFolderCommand}" />
                    <Button Content="导出日志" Padding="12,6" Margin="0,0,8,8"
                            Click="OnExportClick" />
                    <Button Content="一键打包诊断" Padding="12,6" Margin="0,0,8,8"
                            Click="OnPackClick"
                            ToolTip="把日志、两个配置文件和环境信息打包成一个 zip —— 出问题时把 zip 发给别人，比文字描述有用得多。" />
                    <Button Content="清空显示" Padding="12,6" Margin="0,0,0,8"
                            Command="{Binding ClearCommand}"
                            ToolTip="只清空界面上的显示，日志文件一个字节都不动。" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 日志列表 -->
        <Border Grid.Row="3" Style="{DynamicResource Card}"
                Padding="2" Margin="20,16,20,20">
            <ListBox x:Name="LogList"
                     ItemsSource="{Binding Lines}"
                     Background="Transparent"
                     BorderThickness="0"
                     FontFamily="Consolas, Microsoft YaHei UI"
                     FontSize="{DynamicResource FontSize.Caption}"
                     Foreground="{DynamicResource Brush.TextPrimary}"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     ScrollViewer.ScrollChanged="OnLogScrollChanged" />
        </Border>

        <!-- Toast -->
        <Border x:Name="ToastPanel"
                Grid.Row="0" Grid.RowSpan="4"
                Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,24,24"
                Background="{DynamicResource Brush.TextPrimary}"
                CornerRadius="6" Padding="16,10"
                MouseLeftButtonUp="OnToastClick">
            <TextBlock x:Name="ToastText"
                       Foreground="{DynamicResource Brush.Surface}"
                       Style="{DynamicResource Text.Body}" />
        </Border>
    </Grid>
</UserControl>
