<!-- ============================================================
     DataAndFilesView.xaml —— 「数据与档案」板块的容器（**页内 Tab**）
     ============================================================
     【为什么需要这一层】（定稿 §8.2）
       导航分三级：**一级 = 左导航，二级 = 页内 Tab，三级 = 卡片**。
       "数据与档案"底下有 5 个二级页，全塞进左导航会让导航长得没法看；
       一页堆 5 组卡片又会撑爆 §8.4 的"单页 ≤400 行"约束。
       → 所以这一层只干一件事：**把二级页装进 Tab**。

     【它自己没有任何逻辑】
       不持有状态、不认识配置 —— 只负责"造出各页并塞进去"。
       哪一页的 VM 需要什么，就在 code-behind 里给它。

     【还没做的二级页】
       标题上直接写「（未做）」而不是留空白 Tab ——
       空白页会让用户以为点坏了（定稿 §1.2 的老规矩：不许"点了没反应"）。
     ============================================================ -->
<UserControl x:Class="OsuLive2dOverlay.DataAndFilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource FontFamily.UI}"
             FontSize="{DynamicResource FontSize.Body}"
             Foreground="{DynamicResource Brush.TextPrimary}">

    <TabControl x:Name="Tabs"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                Margin="0">
        <TabItem x:Name="HealthTab" Header="配置体检" />
        <TabItem x:Name="LogTab" Header="日志与诊断" />
        <TabItem x:Name="LocationTab" Header="程序与数据源" />
        <TabItem x:Name="ProfileTab" Header="配置档案" />
        <TabItem x:Name="RunTimeTab" Header="运行期调整" />
    </TabControl>
</UserControl>
