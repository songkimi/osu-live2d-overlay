<!-- ============================================================
     HealthCheckView.xaml —— 「数据与档案 → 配置体检」页
     ============================================================
     【它为什么值得早做】
       21 条体检规则早就实现好了（ConfigHealthCheck.cs，实测 35/35），只差界面。
       做完之后，后面每做一页，"配置配错了"都能立刻看出来 ——
       它就是开发这套设置界面时的**工具箱**。

     【页面骨架照 §8.2 的统一模板】
       顶部：标题 + 一行说明（+ 这一页特有的工具条）
       卡片：一组 = 一张卡（这里是"一个板块的问题")
       空状态：没问题时给一句明确的话，不要给一张空白

     【第一版只做"看"】
       "就地修复"和"点击定位"留到后面 —— 前者要定"改完要不要立刻存"，
       后者要跨页面导航（SettingIndex 目前只索引当前页）。
       锚点已经埋好了（体检每条都带 FieldPath），跳转随时能接。
     ============================================================ -->
<UserControl x:Class="OsuLive2dOverlay.HealthCheckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:OsuLive2dOverlay"
             FontFamily="{DynamicResource FontFamily.UI}"
             FontSize="{DynamicResource FontSize.Body}"
             Foreground="{DynamicResource Brush.TextPrimary}"
             Loaded="OnLoaded">

    <UserControl.Resources>
        <!-- bool → Visibility。WPF 自带这个转换器，不用自己写。 -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================================
             内容
             ============================================================ -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel Margin="20">

                <TextBlock Text="配置体检" Style="{DynamicResource Text.PageTitle}" />
                

                <!-- 汇总条 -->
                <Border Style="{DynamicResource Card}" Margin="0,0,0,16" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Summary}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.CardTitle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasNoIssues}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding CheckedAt, StringFormat=检查于 {0}}"
                                       Style="{DynamicResource Text.Label}" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="检查模式" VerticalAlignment="Center"
                                       Style="{DynamicResource Text.Caption}" Margin="0,0,8,0" />
                            <ComboBox svc:SettingIndex.Path="体检.检查模式"
                                      Width="120"
                                      ItemsSource="{Binding CheckModeOptions}"
                                      SelectedItem="{Binding CheckMode}"
                                      ToolTip="宽松：能兜住的问题只提醒（可以点忽略放行）｜严格：必须改掉。它只影响「区间与标识」那几条。" />
                            <Button Content="重新检查" Padding="14,6" Margin="10,0,0,0"
                                    Command="{Binding RecheckCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 空状态：没问题时给一句明确的话 -->
                <Border Style="{DynamicResource Card}" Padding="20"
                        Visibility="{Binding HasNoIssues, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="没发现问题" Style="{DynamicResource Text.CardTitle}"
                                   Foreground="{DynamicResource Brush.Success}" />
                        
                    </StackPanel>
                </Border>

                <!-- 问题清单：一个板块一张卡 -->
                <ItemsControl ItemsSource="{Binding IssueGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{DynamicResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Style="{DynamicResource Text.CardTitle}" />
                                        <TextBlock Text="{Binding CountText}" Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Style="{DynamicResource Text.Caption}" />
                                    </StackPanel>

                                    <ItemsControl ItemsSource="{Binding Items}" Margin="0,12,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 级别徽标：实心底 + 白字，扫一眼就知道轻重 -->
                                                    <Border Grid.Column="0" CornerRadius="4"
                                                            Padding="8,3" VerticalAlignment="Top">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource Brush.TextSecondary}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding LevelText}" Value="错误">
                                                                        <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding LevelText}" Value="警告">
                                                                        <Setter Property="Background" Value="{DynamicResource Brush.Warning}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding LevelText}"
                                                                   Foreground="White"
                                                                   Style="{DynamicResource Text.Label}" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding Message}"
                                                                   Style="{DynamicResource Text.Body}"
                                                                   TextWrapping="Wrap" />
                                                        <!-- FieldPath 是"给程序用的坐标"，显示出来是为了让他知道
                                                             改配置文件时该找哪一项 -->
                                                        <TextBlock Text="{Binding FieldPath}"
                                                                   Style="{DynamicResource Text.Label}"
                                                                   Margin="0,4,0,0"
                                                                   ToolTip="这一项在配置文件里的位置" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 下一步要做的两件事，写在界面上免得当成忘了 -->
                

            </StackPanel>
        </ScrollViewer>

        <!-- Toast（与通用页同一套做法；错误类不自动消失） -->
        <Border x:Name="ToastPanel"
                Grid.Row="0" Grid.RowSpan="2"
                Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,24,24"
                Background="{DynamicResource Brush.TextPrimary}"
                CornerRadius="6" Padding="16,10"
                MouseLeftButtonUp="OnToastClick">
            <TextBlock x:Name="ToastText"
                       Foreground="{DynamicResource Brush.Surface}"
                       Style="{DynamicResource Text.Body}" />
        </Border>
    </Grid>
</UserControl>
