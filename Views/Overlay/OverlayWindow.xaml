<!-- ============================================================
     OverlayWindow.xaml —— Live2D 悬浮窗（WebView2 承载渲染）
     注意两个 WebView2 特有的坑：
       ① Airspace：WebView2 是原生窗口，WPF 元素盖不到它上面
          → 所以"调整模式"的虚线框不能在它上面叠加，只能先把 WebView2 藏起来
       ② 点击穿透必须传到 WebView2 的子窗口（代码后置里用 EnumChildWindows 处理）
     ============================================================ -->
<Window x:Class="OsuLive2dOverlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:svc="clr-namespace:OsuLive2dOverlay"
        Title="osu-live2d-overlay"
        Icon="/Resources/olo-small.png"
        Width="{x:Static svc:OverlayWindow.DefaultWidth}"
        Height="{x:Static svc:OverlayWindow.DefaultHeight}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        ResizeMode="CanResize">

    <Grid>
        <!-- Live2D 渲染区（WebView2）；透明背景在代码里设置（DefaultBackgroundColor=Transparent） -->
        <wv2:WebView2 x:Name="Web" />

        <!-- 调整模式占位层：因为盖不到 WebView2 上面，调整时会先把 WebView2 隐藏 -->
        <Grid x:Name="AdjustLayer" Visibility="Collapsed" Background="#E6101418">
            <Rectangle RadiusX="14" RadiusY="14" Stroke="#FFFFC107" StrokeThickness="3" StrokeDashArray="6 4" />
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="调整模式" FontSize="20" FontWeight="Bold"
                           Foreground="#FFFFC107" HorizontalAlignment="Center" />
                <TextBlock x:Name="AdjustHint" Foreground="White" FontSize="13"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360"
                           HorizontalAlignment="Center" Margin="0,10,0,0" />
                <TextBlock Text="Ctrl+Alt+E 完成 · Ctrl+Alt+Q 退出"
                           Foreground="#FFFFC107" FontSize="12" TextWrapping="Wrap" MaxWidth="380"
                           HorizontalAlignment="Center" Margin="0,14,0,0" />
            </StackPanel>
        </Grid>

        <!-- 这里**故意不放**任何"接鼠标"的层：
             本窗口里嵌着 WebView2（HwndHost），它会阻断所在区域的 WPF 命中测试，
             放什么透明元素都收不到鼠标。接鼠标由 InteractionWindow 那个独立的
             透明窗口负责 —— 见它的说明。 -->

        <!-- 也**故意不放**任何"状态文字"层：原来这里有一条右上角状态条
             （`ShowStatus` 的 WPF 那一半），运行时本来就基本被 WebView2 盖住，
             ★ 2026-09-23 连同页面底部那条弹幕一起撤掉了 —— 一切信息进日志，
             理由见 OverlayWindow.xaml.cs 里"状态提示：**已撤掉**"那一段。 -->
    </Grid>
</Window>
