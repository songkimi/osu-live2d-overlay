<!-- ============================================================
     AboutView.xaml —— 「应用 → 关于」页

     【版式学的是用户给的参考图（SpringNote 的设置 → 关于）】
       两张卡片：
         ① **身份卡**：图标 + 软件名 + 一句说明
         ② **关于卡**：一张卡片里**竖排若干行**，每行 = 左小图标 + 标签 …… 右边值 / ›
            —— 不是"一物一卡"。这类"键值清单"挤在一张卡里更整齐，也不会让页面拉得很长。
       行与行之间拉一条浅线（`Brush.Divider`），整块读起来像一张表。

     【这一版刻意删掉的】
       · **文件都在哪**（配置/档案/程序目录那四个框）：用户指出"已经有一处显示了" ——
         那些路径在「数据与档案 → 程序与数据源」页有，且那一页还能直接打开文件夹。
         同一份信息摆两处，迟早出现"两边不一样"。
       · **GitHub / 官网链接**：地址会变，死链比没有更让用户困惑；地址归 README 维护。
     ============================================================ -->
<UserControl x:Class="OsuLive2dOverlay.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource FontFamily.UI}"
             FontSize="{DynamicResource FontSize.Body}"
             Foreground="{DynamicResource Brush.TextPrimary}"
             Loaded="OnLoaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
        <StackPanel Margin="20" MaxWidth="760" HorizontalAlignment="Left">

            <TextBlock Text="关于" Style="{DynamicResource Text.PageTitle}" Margin="0,0,0,16" />

            <!-- ① 身份卡：图标 + 名字 + 一句说明 -->
            <Border Style="{DynamicResource Card}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="/Resources/olo-small.png"
                           Width="48" Height="48" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="osu-live2d-overlay" Style="{DynamicResource Text.CardTitle}" />
                        
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ② 关于卡：一张卡片里竖排若干行（版式见文件头） -->
            <Border Style="{DynamicResource Card}">
                <StackPanel>
                    <TextBlock Text="关于" Style="{DynamicResource Text.CardTitle}" />

                    <!-- 版本 -->
                    <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1"
                            Padding="0,10" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE946;" Style="{DynamicResource Icon.Small}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="版本" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Style="{DynamicResource Text.Body}" />
                            <TextBlock Grid.Column="2" Text="{Binding Version}" VerticalAlignment="Center"
                                       Style="{DynamicResource Text.Caption}" />
                        </Grid>
                    </Border>

                    <!-- 系统 -->
                    <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1"
                            Padding="0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE7F8;" Style="{DynamicResource Icon.Small}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="系统" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Style="{DynamicResource Text.Body}" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding SystemText}" TextWrapping="Wrap"
                               Style="{DynamicResource Text.Caption}" Margin="0,0,0,10" />

                    <!-- 运行时 -->
                    <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1"
                            Padding="0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE756;" Style="{DynamicResource Icon.Small}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="运行时" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Style="{DynamicResource Text.Body}" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding RuntimeText}" TextWrapping="Wrap"
                               Style="{DynamicResource Text.Caption}" Margin="0,0,0,10" />

                    <!-- 界面缩放 -->
                    <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1"
                            Padding="0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE8FD;" Style="{DynamicResource Icon.Small}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="界面缩放" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Style="{DynamicResource Text.Body}" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding DpiText}" TextWrapping="Wrap"
                               Style="{DynamicResource Text.Caption}" Margin="0,0,0,10" />

                    <!-- 授权：这一行是**说明**，不是待办 -->
                    <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1"
                            Padding="0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE8C1;" Style="{DynamicResource Icon.Small}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="授权" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Style="{DynamicResource Text.Body}" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding LicenseText}" TextWrapping="Wrap"
                               Style="{DynamicResource Text.Caption}" Margin="0,0,0,4" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
