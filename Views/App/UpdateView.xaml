<!-- ============================================================
     UpdateView.xaml —— 「应用 → 更新」页

     【这一页现在只有一个置灰的按钮，是刻意的】
       用户 2026-09-24："更新这页是我没接触过的技术栈，我想先放着，按钮可以放一个。"
       而"检查更新"要联网（HTTP 请求 + 版本比较 + 下载/跳转），是还没学的那部分。

     **不摆一个"点了没反应"的按钮**（定稿 §1.2 明令禁止的东西）：
     按钮置灰、并在下面写清为什么（§1.1：只灰不解释的控件在用户眼里就是"这软件有毛病"）。

     等联网那块学完，这里就是：启动时检查更新（开关）+ 手动检查（按钮）+ 更新日志。
     ============================================================ -->
<UserControl x:Class="OsuLive2dOverlay.UpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource FontFamily.UI}"
             FontSize="{DynamicResource FontSize.Body}"
             Foreground="{DynamicResource Brush.TextPrimary}"
             Loaded="OnLoaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
        <StackPanel Margin="20">

            <TextBlock Text="更新" Style="{DynamicResource Text.PageTitle}" />
            <TextBlock Text="检查有没有新版本。"
                       TextWrapping="Wrap"
                       Style="{DynamicResource Text.Caption}" Margin="0,6,0,16" />

            <Border Style="{DynamicResource Card}">
                <StackPanel>
                    <TextBlock Text="检查更新" Style="{DynamicResource Text.CardTitle}" />

                    <Button Content="检查更新" Padding="18,6" HorizontalAlignment="Left"
                            Margin="0,12,0,0"
                            IsEnabled="False" />

                    <TextBlock Text="还没做 —— 检查更新要联网，这块技术我还在学。所以按钮先置灰，不做成「点了没反应」。"
                               TextWrapping="Wrap"
                               Style="{DynamicResource Text.Caption}"
                               Margin="0,10,0,0" />

                    <TextBlock Text="想手动看版本：本页顶部没有，去「应用 → 关于」页，那儿显示当前版本号。"
                               TextWrapping="Wrap"
                               Style="{DynamicResource Text.Caption}"
                               Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>