<!-- ============================================================
     OverlaySettingsView.xaml —— 「联动与窗口 → 悬浮窗」页

     【页内按"作用范围"分】（定稿 §2④-1）
       全局区（一份）+ 按界面区（四份，四个 Tab）。一级按"这东西是什么"分，
       页内按"作用范围"分 —— 两个维度各管一件事，不再互相污染。

     【★ 全局区这一版没做，而且是刻意的】
       那六个字段**一个都没人读**（详见 ViewModel 文件头）。照文档摆控件 =
       一次性造六个"改了没反应"，其中一个是"照界面提示按键、按不出来"。

     【四个 Tab 用同一份模板】
       九行控件抄四遍的下场是"改一个界面漏三个"。所以 TabControl 绑到
       四个 ViewModel 实例上，ContentTemplate 只有一份。

     【数字框用 LostFocus 提交】
       边打字边提交会把"1"、"12"、"120" 一路写进配置 —— 中间那些值会
       让预览里的角色来回乱跳。离开输入框再提交，稳得多。
     ============================================================ -->
<UserControl x:Class="OsuLive2dOverlay.OverlaySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:OsuLive2dOverlay"
             FontFamily="{DynamicResource FontFamily.UI}"
             FontSize="{DynamicResource FontSize.Body}"
             Foreground="{DynamicResource Brush.TextPrimary}"
             Loaded="OnLoaded">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <!-- 预览栏跟着窗口一起变宽（原来写死 360：用户把设置窗口拉大，
                     预览区一点都不长，"看不到完整弹窗内容"就是这么来的）。
                     给下限是为了窗口很窄时不至于把配置区挤没。 -->
                <ColumnDefinition Width="3*" MinWidth="380" />
                <ColumnDefinition Width="2*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <!-- ============ 左：配置区 ============ -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <StackPanel Margin="20">

                    <TextBlock Text="悬浮窗" Style="{DynamicResource Text.PageTitle}" />
                    

                    <!-- 全局区（★ 2026-09-23 补上：这几项存在软件设置里，不随档案走） -->
                    <Border Style="{DynamicResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="全局区" Style="{DynamicResource Text.CardTitle}" />
                            <TextBlock Text="整个悬浮窗的行为，不随档案走。"
                                       TextWrapping="Wrap"
                                       Style="{DynamicResource Text.Caption}"
                                       Margin="0,6,0,0" />

                            <!-- 位置锁定 -->
                            <TextBlock Text="位置锁定" Style="{DynamicResource Text.Label}" Margin="0,14,0,4" />
                            <ToggleButton Style="{DynamicResource ToggleSwitch}"
                                          IsChecked="{Binding LockPosition}"
                                          HorizontalAlignment="Left" />
                            <TextBlock Text="打开之后拖不动窗口。"
                                       TextWrapping="Wrap"
                                       Style="{DynamicResource Text.Caption}"
                                       Margin="0,6,0,0" />

                            <!-- 吸附距离 -->
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="边缘吸附距离" VerticalAlignment="Center"
                                           Style="{DynamicResource Text.Label}" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="80"
                                        SmallChange="1" LargeChange="8"
                                        VerticalAlignment="Center"
                                        Value="{Binding SnapDistance}" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" MinWidth="56"
                                           TextAlignment="Right" Margin="10,0,0,0"
                                           Style="{DynamicResource Text.Caption}">
                                    <Run Text="{Binding SnapDistance, Mode=OneWay}" />
                                    <Run Text="DIP" />
                                </TextBlock>
                            </Grid>
                            

                            <!-- 热键：**只读展示**，不给改 -->
                            <TextBlock Text="全局热键" Style="{DynamicResource Text.Label}" Margin="0,16,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="临时允许交互" VerticalAlignment="Center"
                                           Style="{DynamicResource Text.Caption}" />
                                <TextBox Grid.Column="1" IsReadOnly="True"
                                         Text="{Binding TempInteractiveHotkey, Mode=OneWay}" />
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="结束悬浮窗" VerticalAlignment="Center"
                                           Style="{DynamicResource Text.Caption}" />
                                <TextBox Grid.Column="1" IsReadOnly="True"
                                         Text="{Binding StopHotkey, Mode=OneWay}" />
                            </Grid>
                            
                        </StackPanel>
                    </Border>

                    <!-- 按界面区 -->
                    <Border Style="{DynamicResource Card}">
                        <StackPanel>
                            <TextBlock Text="按界面区" Style="{DynamicResource Text.CardTitle}" />

                            <TabControl ItemsSource="{Binding Scenes}"
                                        SelectedItem="{Binding Selected}"
                                        Background="Transparent" BorderThickness="0"
                                        Padding="0" Margin="0,10,0,0">
                                <TabControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Title}" />
                                    </DataTemplate>
                                </TabControl.ItemTemplate>

                                <TabControl.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,14,0,0">

                                            <!-- 启用 -->
                                            <StackPanel Style="{DynamicResource SettingRow}">
                                                <TextBlock Text="启用这个界面" Style="{DynamicResource Text.Body}" />
                                                <ToggleButton svc:SettingIndex.Path="界面感知.启用"
                                                              Style="{DynamicResource ToggleSwitch}"
                                                              IsChecked="{Binding Enabled}"
                                                              HorizontalAlignment="Left" Margin="0,6,0,0" />
                                                <TextBlock Text="关掉就不显示角色。"
                                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                                           Style="{DynamicResource Text.Caption}" Margin="0,5,0,0" />
                                            </StackPanel>

                                            <!-- 窗口尺寸 -->
                                            <StackPanel Style="{DynamicResource SettingRow}">
                                                <TextBlock Text="悬浮窗尺寸（DIP）" Style="{DynamicResource Text.Body}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <TextBox svc:SettingIndex.Path="界面感知.悬浮窗.宽"
                                                             Width="90" Text="{Binding WindowWidth, UpdateSourceTrigger=LostFocus}"
                                                             VerticalContentAlignment="Center" />
                                                    <TextBlock Text="×" Margin="8,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Brush.TextSecondary}" />
                                                    <TextBox svc:SettingIndex.Path="界面感知.悬浮窗.高"
                                                             Width="90" Text="{Binding WindowHeight, UpdateSourceTrigger=LostFocus}"
                                                             VerticalContentAlignment="Center" />
                                                    <TextBlock Text="填 0 = 用程序默认尺寸" Margin="12,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                                               Style="{DynamicResource Text.Caption}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding SizeWarning}"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource Brush.Warning}"
                                                           Visibility="{Binding HasSizeWarning, Converter={StaticResource BoolToVis}}"
                                                           Style="{DynamicResource Text.Caption}" Margin="0,5,0,0" />
                                            </StackPanel>

                                            <!-- 穿透与吸附 -->
                                            <StackPanel Style="{DynamicResource SettingRow}">
                                                <TextBlock Text="点击穿透" Style="{DynamicResource Text.Body}" />
                                                <ToggleButton svc:SettingIndex.Path="界面感知.悬浮窗.点击穿透"
                                                              Style="{DynamicResource ToggleSwitch}"
                                                              IsChecked="{Binding ClickThrough}"
                                                              HorizontalAlignment="Left" Margin="0,6,0,0" />
                                                
                                            </StackPanel>

                                            <StackPanel Style="{DynamicResource SettingRow}">
                                                <TextBlock Text="自动吸附" Style="{DynamicResource Text.Body}" />
                                                <ToggleButton svc:SettingIndex.Path="界面感知.悬浮窗.自动吸附"
                                                              Style="{DynamicResource ToggleSwitch}"
                                                              IsChecked="{Binding SnapToEdges}"
                                                              HorizontalAlignment="Left" Margin="0,6,0,0" />
                                                <TextBlock Text="松开鼠标时吸到屏幕边缘。"
                                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                                           Style="{DynamicResource Text.Caption}" Margin="0,5,0,0" />
                                            </StackPanel>

                                            <!-- 角色站位 -->
                                            <StackPanel Style="{DynamicResource SettingRow}">
                                                <TextBlock Text="{Binding PlacementTitle}" Style="{DynamicResource Text.Body}" />

                                                <!-- 四项都用滑块：它们是**比例**（-1~1），
                                                     手打数字既慢又看不出量级；而且滑块一拖预览就跟着动，
                                                     不用"改 → 保存 → 看"来回折腾。 -->
                                                <Grid Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="52" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="左右" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Brush.TextSecondary}" />
                                                    <Slider Grid.Column="1" svc:SettingIndex.Path="界面感知.站位.X"
                                                            Minimum="-1" Maximum="1" TickFrequency="0.01"
                                                            VerticalAlignment="Center"
                                                            Value="{Binding CharacterX}" />
                                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
                                                               Text="{Binding CharacterX, StringFormat={}{0:0.00}}" />
                                                </Grid>

                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="52" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="上下" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Brush.TextSecondary}" />
                                                    <Slider Grid.Column="1" svc:SettingIndex.Path="界面感知.站位.Y"
                                                            Minimum="-1" Maximum="1" TickFrequency="0.01"
                                                            VerticalAlignment="Center"
                                                            Value="{Binding CharacterY}" />
                                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
                                                               Text="{Binding CharacterY, StringFormat={}{0:0.00}}" />
                                                </Grid>

                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="52" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="缩放" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Brush.TextSecondary}" />
                                                    <Slider Grid.Column="1" svc:SettingIndex.Path="界面感知.站位.缩放"
                                                            Minimum="0.1" Maximum="3" TickFrequency="0.01"
                                                            VerticalAlignment="Center"
                                                            Value="{Binding CharacterScale}" />
                                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
                                                               Text="{Binding CharacterScale, StringFormat={}{0:0.00}}" />
                                                </Grid>

                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="52" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="角度" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Brush.TextSecondary}" />
                                                    <Slider Grid.Column="1" svc:SettingIndex.Path="界面感知.站位.角度"
                                                            Minimum="-180" Maximum="180" TickFrequency="1"
                                                            VerticalAlignment="Center"
                                                            Value="{Binding CharacterAngle}" />
                                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
                                                               Text="{Binding CharacterAngle, StringFormat={}{0:0}°}" />
                                                </Grid>

                                                <TextBlock Text="{Binding PlacementHint}"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                                           Style="{DynamicResource Text.Caption}" Margin="0,8,0,0" />
                                            </StackPanel>

                                            <!-- 允许触摸 -->
                                            <StackPanel Style="{DynamicResource SettingRow}">
                                                <TextBlock Text="允许触摸" Style="{DynamicResource Text.Body}" />
                                                <ToggleButton Style="{DynamicResource ToggleSwitch}"
                                                              IsChecked="{Binding TouchEnabled}"
                                                              HorizontalAlignment="Left" Margin="0,6,0,0" />
                                            </StackPanel>

                                            <!-- 只有「打歌」有：按模式分站位（决策 50） -->
                                            <StackPanel Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}">
                                                <Separator Margin="0,10,0,6" />
                                                <TextBlock Text="按游玩模式分站位" Style="{DynamicResource Text.CardTitle}" />
                                                

                                                <ItemsControl ItemsSource="{Binding Modes}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <!-- 2×2：四个模式各一张卡片。
                                                                 挤成一排的时候每一行的输入框只能做得很窄，
                                                                 四个模式谁是谁反而看不清。 -->
                                                            <UniformGrid Columns="2" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>

                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,0,8,8" Padding="12"
                                                                    CornerRadius="{DynamicResource Radius.Control}"
                                                                    Background="{DynamicResource Brush.Window}"
                                                                    BorderBrush="{DynamicResource Brush.Border}"
                                                                    BorderThickness="1">
                                                                <StackPanel>
                                                                    <Grid>
                                                                        <TextBlock Text="{Binding Title}"
                                                                                   HorizontalAlignment="Left"
                                                                                   VerticalAlignment="Center"
                                                                                   Style="{DynamicResource Text.CardTitle}" />
                                                                        <CheckBox Content="单独设置"
                                                                                  HorizontalAlignment="Right"
                                                                                  VerticalAlignment="Center"
                                                                                  IsChecked="{Binding Enabled}" />
                                                                    </Grid>

                                                                    <!-- 没勾 = 这一份不生效，输入框整组置灰 -->
                                                                    <Grid Margin="0,10,0,0" IsEnabled="{Binding Enabled}">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>

                                                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,6,6">
                                                                            <TextBlock Text="左右" Width="30" VerticalAlignment="Center"
                                                                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                                                                       Style="{DynamicResource Text.Caption}" />
                                                                            <TextBox Width="62" Text="{Binding X, UpdateSourceTrigger=LostFocus}"
                                                                                     VerticalContentAlignment="Center" />
                                                                        </StackPanel>

                                                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                                                                            <TextBlock Text="上下" Width="30" VerticalAlignment="Center"
                                                                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                                                                       Style="{DynamicResource Text.Caption}" />
                                                                            <TextBox Width="62" Text="{Binding Y, UpdateSourceTrigger=LostFocus}"
                                                                                     VerticalContentAlignment="Center" />
                                                                        </StackPanel>

                                                                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,6,0">
                                                                            <TextBlock Text="缩放" Width="30" VerticalAlignment="Center"
                                                                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                                                                       Style="{DynamicResource Text.Caption}" />
                                                                            <TextBox Width="62" Text="{Binding Scale, UpdateSourceTrigger=LostFocus}"
                                                                                     VerticalContentAlignment="Center" />
                                                                        </StackPanel>

                                                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                                                            <TextBlock Text="角度" Width="30" VerticalAlignment="Center"
                                                                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                                                                       Style="{DynamicResource Text.Caption}" />
                                                                            <TextBox Width="62" Text="{Binding Angle, UpdateSourceTrigger=LostFocus}"
                                                                                     VerticalContentAlignment="Center" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                
                                            </StackPanel>

                                            <!-- 一键同步 -->
                                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                                <Button Content="填给还没配置的界面" Padding="14,6"
                                                        Command="{Binding DataContext.ApplyToOthersCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        ToolTip="把这一档的设置填给还没启用过的界面（已经配好的不动）" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </TabControl.ContentTemplate>
                            </TabControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ============ 右：预览区 ============ -->
            <Border Grid.Column="1"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 预览看哪一份站位（只有打歌有模式站位时才露） -->
                    <StackPanel Grid.Row="0" Margin="12,12,12,0"
                                Visibility="{Binding Selected.IsPlaying, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="预览这一份站位" Style="{DynamicResource Text.Caption}"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                        <ComboBox ItemsSource="{Binding PreviewModeOptions}"
                                  SelectedIndex="{Binding PreviewModeIndex}"
                                  Margin="0,4,0,0" />
                    </StackPanel>

                    <svc:PreviewPane x:Name="Preview" Grid.Row="1" />
                </Grid>
            </Border>
        </Grid>

        <!-- ============ 底部保存栏 ============ -->
        <Border Grid.Row="1"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="● 未保存" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Warning}"
                           FontWeight="SemiBold"
                           Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVis}}"
                           Style="{DynamicResource Text.Caption}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="恢复默认" Padding="14,6" Command="{Binding ResetToDefaultCommand}" />
                    <Button Content="放弃" Padding="14,6" Margin="8,0,0,0" Command="{Binding DiscardCommand}" />
                    <Button Content="保存" Padding="18,6" Margin="8,0,0,0"
                            Command="{Binding SaveCommand}"
                            Background="{DynamicResource Brush.Primary}"
                            Foreground="{DynamicResource Brush.TextOnPrimary}"
                            BorderBrush="{DynamicResource Brush.Primary}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toast -->
        <Border x:Name="ToastPanel"
                Grid.Row="0" Grid.RowSpan="2"
                Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,24,68"
                Background="{DynamicResource Brush.TextPrimary}"
                CornerRadius="6" Padding="16,10"
                MouseLeftButtonUp="OnToastClick">
            <TextBlock x:Name="ToastText"
                       Foreground="{DynamicResource Brush.Surface}"
                       Style="{DynamicResource Text.Body}" />
        </Border>
    </Grid>
</UserControl>
