  "视图": {
    "_说明": "缩放 1.0 = 模型完整装进窗口（安全的默认值）。调大后配合「上下位置」把脸移进画面。",
    "缩放": 1.0,
    "上下位置": 0.0,
    "左右位置": 0.0
  },

  "_解耦说明": "表情写「演什么」，语音情绪写「说什么」—— 两件事各写各的，互不影响：某个表情没播出来，语音照样说；语音文件缺了，表情照样演。不想让某个事件出声，把语音情绪留空（\"\"）即可。",
  "连击触发": [
    { "阈值": 50,  "表情": "圈圈眼",     "语音情绪": "高兴" },
    { "阈值": 100, "表情": "麦克风动作", "语音情绪": "高兴" },
    { "阈值": 200, "表情": "加载",       "语音情绪": "疑惑" }
  ],

  "_失误说明": "断连击前手里得先有像样的连击，角色才会理你 —— 连击还没到「小额门槛」就断了，表情和语音都什么都不做。玩得菜的时候一直被安慰只会更难受，而且门槛本身就是最好的节流。",
  "失误触发": {
    "小额门槛": 50,
    "小额表情": "生气2",
    "小额语音情绪": "吐槽",
    "大额门槛": 100,
    "大额表情": "害羞",
    "大额语音情绪": "伤心"
  },

  "语音": {
    "_说明": "一个情绪里放了多个文件，每次随机挑一个（同一袋里不重复）。情绪里「文件」为空时，会自动去「目录」下找同名子文件夹（例：voice\\高兴\\*.wav），所以文件多了直接建文件夹丢进去就行。",
    "启用": true,
    "目录": "D:\\AI\\My work\\osu插件探索\\voice",
    "音量": 0.8,
    "_最小间隔毫秒说明": "两次语音之间至少隔这么久，防止断连击时连着往外冒。0 = 不限。",
    "最小间隔毫秒": 300,
    "情绪": [
      { "名称": "高兴", "文件": [ "加油.wav", "最喜欢了.wav" ] },
      { "名称": "疑惑", "文件": [ "喵？.wav" ] },
      { "名称": "伤心", "文件": [ "可惜.wav", "对不起.wav" ] },
      { "名称": "吐槽", "文件": [ "太慢了.wav" ] },
      { "名称": "平静", "文件": [ "喵（平静）.wav" ] }
    ]
  },

  "_口型说明": "说话时让角色张嘴（不然只有声音、人不动很出戏）。「参数」留空 = 自动在模型里找口型参数（不同模型命名可能不一样）。觉得嘴张太大就把「幅度」调小。",
  "口型": {
    "启用": true,
    "参数": "",
    "幅度": 1.0
  },

  "表情持续时间毫秒": 1500,

  "_目光跟随鼠标说明": "true = 角色看向你的鼠标位置（窗口是点击穿透的，所以由程序读光标位置）。不想用就改成 false。",
  "目光跟随鼠标": true,

  "_调试模式说明": "true = 在画面上显示开发期信息（如某个表情没播出来），并把日志写到 %TEMP%\\ComboOverlay\\debug.log。面向玩家时保持 false，避免打扰。",
  "调试模式": false
}
